---
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
  label: string;
}

const { currentPage, lastPage, prevUrl, nextUrl, label } = Astro.props;
---

<nav class="mt-16 flex items-center justify-between gap-4 border-t border-border pt-6" aria-label={label}>
  {
    prevUrl ? (
      <a href={prevUrl} class="nav-link link-nudge">
        <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> Newer
      </a>
    ) : (
      <span class="nav-link opacity-40">&larr; Newer</span>
    )
  }
  <span class="text-xs tracking-widest text-muted-foreground uppercase">
    Page {currentPage} / {lastPage}
  </span>
  {
    nextUrl ? (
      <a href={nextUrl} class="nav-link link-nudge">
        Older <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
      </a>
    ) : (
      <span class="nav-link opacity-40">Older &rarr;</span>
    )
  }
</nav>
