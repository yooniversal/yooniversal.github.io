---
import LocalIcon from "@/components/LocalIcon.astro";

const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner flex flex-col gap-2 py-8 text-center text-xs text-muted-foreground sm:flex-row sm:justify-between sm:text-left">
    <div class="space-y-2">
      <nav aria-label="프로필 링크" class="flex justify-center gap-4 sm:justify-start">
        <a href="https://github.com/yooniversal" class="link-quiet inline-flex items-center gap-1.5">
          <LocalIcon name="github" className="size-3" />
          {"GitHub"}
        </a>
        <a href="https://www.linkedin.com/in/dbyoooooon" class="link-quiet inline-flex items-center gap-1.5">
          <LocalIcon name="linkedin" className="size-3" />
          {"LinkedIn"}
        </a>
      </nav>
      <p>&copy; {currentYear}. All rights reserved.</p>
    </div>
    <div class="space-y-1 sm:text-right">
      <p>
        Built with{" "}
        <a href="https://astro.build/" class="link-quiet underline underline-offset-2">Astro</a>
      </p>
      <p>
        <a href="https://github.com/xocothemes/monograph" class="link-quiet underline underline-offset-2">Monograph</a>
        {" Theme"}
      </p>
    </div>
  </div>
</footer>
